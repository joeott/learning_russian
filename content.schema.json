{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language course content",
  "type": "object",
  "required": ["course", "meta", "curriculum", "modules", "items"],
  "properties": {
    "course": { "type": "object" },
    "meta": { "type": "object" },
    "curriculum": {
      "type": "object",
      "required": ["default_lesson_id", "lessons"],
      "properties": {
        "model": { "type": "string" },
        "default_lesson_id": { "type": "string" },
        "lessons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lesson_id",
              "lesson_number",
              "module",
              "title",
              "introduced_lexemes",
              "active_vocab",
              "passive_vocab",
              "introduced_structures",
              "allowed_error_types",
              "prerequisites"
            ]
          }
        }
      }
    },
    "modules": { "type": "array" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lesson_id",
          "lesson_number",
          "lexemes",
          "structures",
          "prerequisites",
          "allowed_error_types"
        ]
      }
    },
    "cloze_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "item_id",
          "lesson_id",
          "lesson_number",
          "prompt_ru",
          "answer",
          "accepted_answers",
          "structures",
          "allowed_error_types"
        ]
      }
    },
    "dictation_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "item_id",
          "lesson_id",
          "lesson_number",
          "ru_plain",
          "accepted_answers",
          "structures",
          "allowed_error_types"
        ]
      }
    },
    "backtranslation_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "item_id",
          "lesson_id",
          "lesson_number",
          "ru",
          "ru_plain",
          "accepted_answers",
          "en",
          "structures",
          "allowed_error_types"
        ]
      }
    },
    "tutor_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scenario_id",
          "lesson_id",
          "lesson_number",
          "setting",
          "goal",
          "required_items",
          "required_phrases",
          "allowed_lesson_ids",
          "allowed_item_ids",
          "active_vocab",
          "structures",
          "allowed_error_types",
          "correction_policy",
          "prompt"
        ]
      }
    },
    "contrast_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "contrast_set_id",
          "item_id",
          "lesson_id",
          "lesson_number",
          "title",
          "prompt",
          "usage_note",
          "options",
          "answer_id",
          "ru",
          "ru_plain",
          "structures",
          "allowed_error_types"
        ]
      }
    },
    "error_types": { "type": "array" },
    "contrast_sets": { "type": "array" },
    "scenarios": { "type": "array" }
  }
}

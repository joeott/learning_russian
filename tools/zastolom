def cmd_stats(args):
    d = load_content()
    print(head(d["meta"]["title"]))
    print(f"  goal: {d['meta']['goal']}")
    print(f"  total phrases: {d['meta']['total_items']}")
    by_pri = {}
    for i in d["items"]:
        by_pri[i["priority"]] = by_pri.get(i["priority"], 0) + 1
    print("  by module:")
    for m in d["modules"]:
        n = d["meta"]["counts"].get(m["id"], 0)
        print(f"    {m['icon']} {m['title']:<34} {n:>3}  (P{m['priority']})")
    print(f"  by priority: " + "  ".join(f"P{k}={v}" for k, v in sorted(by_pri.items())))
    reh = [i["ru"] for i in d["items"] if i["rehearse"]]
    print(f"  ★ rehearse with Kadriya: {len(reh)}")
    have = existing_audio_ids()
    print(f"  audio on disk: {len(have & {i['id'] for i in d['items']})}/{d['meta']['total_items']}")

def which(prog):
    from shutil import which as w
    return w(prog)

# ============================================================ main
def main():
    p = argparse.ArgumentParser(prog="zastolom", add_help=False,
                                description="Agentic CLI for the За столо́м Russian study system.")
    sub = p.add_subparsers(dest="cmd")

    b = sub.add_parser("build"); b.add_argument("target", nargs="?", choices=["content", "anki", "cheatsheet", "all"]); b.add_argument("--course")
    a = sub.add_parser("audio"); asub = a.add_subparsers(dest="acmd")
    g = asub.add_parser("generate")
    g.add_argument("--force", action="store_true"); g.add_argument("--ids"); g.add_argument("--voice"); g.add_argument("--limit", type=int)
    asub.add_parser("voices"); asub.add_parser("coverage")
    s = sub.add_parser("serve"); s.add_argument("--port", type=int, default=8000)
    br = sub.add_parser("browser")
    br.add_argument("url", nargs="?", default="http://localhost:8000/web/")
    group = br.add_mutually_exclusive_group()
    group.add_argument("--desktop", action="store_true")
    group.add_argument("--mobile", action="store_true")
    group.add_argument("--both", action="store_true")
    br.add_argument("--click-text", action="append")
    br.add_argument("--strict", action="store_true", help="fail command when requested clicks are not found")
    br.add_argument("--fail-on-errors", action="store_true", help="treat browser runtime errors as command failure")
    br.add_argument("--offline", action="store_true", help="run with browser offline mode")
    br.add_argument(
        "--service-workers",
        choices=["allow", "block", "disable"],
        default="allow",
        help="service worker behavior while inspecting pages",
    )
    br.add_argument("--out")
    br.add_argument("--wait-ms", type=int)
    fl = sub.add_parser("flow")
    fl.add_argument("url", nargs="?", default="http://localhost:8000/web/")
    fl.add_argument("--out")
    fl.add_argument("--offline", action="store_true", help="run offline replay checks")
    fl.add_argument("--mobile", action="store_true", help="run flow checks with mobile viewport")
    pr = sub.add_parser("preflight")
    pr.add_argument("url", nargs="?", default="http://localhost:8000/web/")
    pr.add_argument("--out")
    pr.add_argument("--offline", action="store_true", help="run flow offline replay checks")
    pr.add_argument("--mobile", action="store_true", help="run flow checks with mobile viewport")
    sub.add_parser("verify")
    sub.add_parser("test")
    sub.add_parser("loop-prompt")
    sl = sub.add_parser("source-loop")
    sl.add_argument("--run", action="store_true", help="run the scouting scan")
    sl.add_argument("--future", action="store_true", help="also scan candidate links from each target page")
    sl.add_argument("--spoken", action="store_true", help="focus targets for spoken-language/listening practice")
    sl.add_argument("--easy", action="store_true", help="only keep short, beginner-safe candidates for canvas")
    sl.add_argument("--limit", type=int, default=0, help="max pages to scan in this run")
    sl.add_argument("--write-canvas", action="store_true", help="append passing candidates to source/candidate_materials.md")
    sl.add_argument("--targets", help="optional JSON target file (defaults to source/source_loop_targets.json)")
    fl = sub.add_parser("future-loop")
    fl.add_argument("--run", action="store_true", help="run the discovery scan and follow-up links")
    fl.add_argument("--spoken", action="store_true", help="focus targets for spoken-language/listening practice")
    fl.add_argument("--easy", action="store_true", help="only keep short, beginner-safe candidates for canvas")
    fl.add_argument("--limit", type=int, default=0, help="max seed pages to scan in this run")
    fl.add_argument("--write-canvas", action="store_true", help="append passing candidates to source/candidate_materials.md")
    fl.add_argument("--targets", help="optional JSON target file (defaults to source/source_loop_targets.json)")
    sub.add_parser("stats")
    sub.add_parser("help")

    args = p.parse_args()
    if not args.cmd or args.cmd == "help":
        print(__doc__); return
    if args.cmd == "build": cmd_build(args)
    elif args.cmd == "audio":
        {"generate": cmd_audio_generate, "voices": cmd_audio_voices,
         "coverage": cmd_audio_coverage}.get(args.acmd, lambda a: print(__doc__))(args)
    elif args.cmd == "serve": cmd_serve(args)
    elif args.cmd == "browser": cmd_browser(args)
    elif args.cmd == "flow": cmd_flow(args)
    elif args.cmd == "preflight": cmd_preflight(args)
    elif args.cmd == "verify": cmd_verify(args)
    elif args.cmd == "test": cmd_test(args)
    elif args.cmd == "loop-prompt": cmd_loop_prompt(args)
    elif args.cmd == "future-loop":
        args.future = True
        cmd_source_loop(args)
    elif args.cmd == "source-loop":
        cmd_source_loop(args)
    elif args.cmd == "stats": cmd_stats(args)

if __name__ == "__main__":
    main()

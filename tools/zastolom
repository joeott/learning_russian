def _run_subcommand(argv):
    command = [sys.executable, os.path.join(ROOT, "tools", "zastolom"), *argv]
    label = argv[0]
    print(head(f"preflight:{label}"))
    print("  → " + " ".join(command))
    r = subprocess.run(command, cwd=ROOT)
    if r.returncode != 0:
        print(err(f"{argv[0]} failed"))
        sys.exit(r.returncode)


def _is_local_url(url):
    parsed = urlsplit(url)
    host = (parsed.hostname or "").lower()
    return host in {"localhost", "127.0.0.1", "::1"}


def _url_is_live(url):
    try:
        with urllib.request.urlopen(url, timeout=2) as r:
            return r.status < 500
    except Exception:
        return False


def _start_local_server(url):
    port = urlsplit(url).port or 8000
    proc = subprocess.Popen(
        [sys.executable, "-m", "http.server", str(port)],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.STDOUT,
    )
    return proc


def _wait_for_server(url, timeout_s=6):
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        if _url_is_live(url):
            return True
        time.sleep(0.35)
    return False


def _ensure_local_flow_target(url):
    if _url_is_live(url):
        return None
    if not _is_local_url(url):
        print(err(f"flow url is not reachable: {url}"))
        print(warn("if this should be a local server, start it first: tools/zastolom serve"))
        sys.exit(2)
    print(warn(f"flow target is not reachable; starting temporary server for {url}"))
    proc = _start_local_server(url)
    if not _wait_for_server(url):
        print(err("temporary server failed to start"))
        proc.terminate()
        try:
            proc.wait(timeout=1)
        except Exception:
            pass
        sys.exit(2)
    return proc


def cmd_preflight(args):
    if not which("node"):
        print(err("node not found — preflight requires node for flow step"))
        sys.exit(2)
    _run_subcommand(["build", "all"])
    _run_subcommand(["verify"])
    _run_subcommand(["test"])
    server_proc = None
    try:
        server_proc = _ensure_local_flow_target(args.url)
        _run_subcommand(
            ["flow", args.url]
            + (["--offline"] if args.offline else [])
            + (["--mobile"] if args.mobile else [])
            + (["--out", args.out] if args.out else [])
        )
    finally:
        if server_proc is not None:
            print(warn("stopping temporary flow server"))
            server_proc.terminate()
            try:
                server_proc.wait(timeout=2)
            except Exception:
                server_proc.kill()

def cmd_verify(args):
    fails = 0
    print(head("verify"))
    # 1 content json
    try:
        d = load_content()
        n = d["meta"]["total_items"]
        assert n == len(d["items"])
        print(ok(f"content.json valid — {n} items"))
    except Exception as e:
        fails += 1; print(err(f"content.json: {e}"))
    # 2 web/content.js mirrors json
    try:
        js = open(os.path.join(ROOT, "web", "content.js"), encoding="utf-8").read()
        print(ok("web/content.js present") if "CONTENT_DATA" in js else err("web/content.js malformed"))
    except OSError:
        fails += 1; print(err("web/content.js missing — run `zastolom build content`"))
    # 3 JS syntax (node if available)
    if which("node"):
        for f in ("web/app.js", "web/service-worker.js", "scripts/browser_controller.mjs", "scripts/browser_flow_check.mjs"):
            r = subprocess.run(["node", "--check", os.path.join(ROOT, f)], capture_output=True)
            if r.returncode == 0:
                print(ok(f"{f} syntax OK"))
            else:
                fails += 1; print(err(f"{f}: {r.stderr.decode()[:160]}"))
    else:
        print(warn("node not found — skipped JS syntax check"))
    # 4 audio coverage (informational)
    try:
        d = load_content(); have = existing_audio_ids()
        miss = [i["id"] for i in d["items"] if i["id"] not in have]
        (print(ok("audio: full coverage")) if not miss
         else print(warn(f"audio: {len(miss)} missing (run `zastolom audio generate`)")))
    except Exception:
        pass
    # 5 anki rows
    try:
        rows = sum(1 for _ in open(os.path.join(ROOT, "anki", "russian_family_visit.txt"), encoding="utf-8")) - 3
        print(ok(f"anki deck: {rows} rows"))
    except OSError:
        print(warn("anki deck not built"))
    print(ok("verify passed") if not fails else err(f"verify FAILED ({fails})"))
    sys.exit(1 if fails else 0)


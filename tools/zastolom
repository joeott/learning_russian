# ---- pretty ----
def c(s, code):  # color if tty
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s
def ok(s): return c("✓ " + s, "32")
def warn(s): return c("! " + s, "33")
def err(s): return c("✗ " + s, "31")
def head(s): return c(s, "1;35")

def load_content():
    with open(CONTENT, encoding="utf-8") as f:
        return json.load(f)

def strip_stress(s):
    return unicodedata.normalize("NFC", s).replace(ACUTE, "")


class _VisibleTextParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self._chunks = []
        self._skip = 0

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if tag in {"script", "style", "noscript", "header", "footer", "nav", "aside"}:
            self._skip += 1

    def handle_endtag(self, tag):
        tag = tag.lower()
        if tag in {"script", "style", "noscript", "header", "footer", "nav", "aside"} and self._skip:
            self._skip -= 1

    def handle_data(self, data):
        if self._skip:
            return
        s = data.strip()
        if s:
            self._chunks.append(s)

    @property
    def text(self):
        return "\n".join(self._chunks)


class _AnchorTextParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() != "a":
            return
        href = dict(attrs).get("href")
        if href:
            self.links.append(href)


def _discover_source_links(seed_url, html_text, target):
    max_links = int(target.get("discover_limit", 0) or 0)
    if max_links <= 0:
        return []
    path_hints = [token.lower() for token in (target.get("discover_paths") or [])]
    blacklist = set(target.get("discover_blacklist", []) + [
        "/search", "/login", "/register", "/account", "/privacy", "/sitemap"
    ])

    try:
        seed = urlsplit(seed_url)
    except Exception:
        return []

    parser = _AnchorTextParser()
    parser.feed(html_text)
    found = []
    seen = set()
    for raw in parser.links:
        try:
            resolved = urljoin(seed_url, raw)
            parsed = urlsplit(resolved)
        except Exception:
            continue
        if not parsed.scheme.startswith("http") or parsed.netloc != seed.netloc:
            continue
        path = (parsed.path or "/").lower()
        if path in {"", "/"}:
            continue
        if any(block in path for block in blacklist):
            continue
        if path_hints and not any(hint in path for hint in path_hints):
            continue
        if any(ext in path for ext in [".jpg", ".png", ".gif", ".svg", ".css", ".js", ".pdf", ".zip", ".mp3"]):
            continue
        candidate = _normalize_canvas_url(resolved)
        if candidate and candidate not in seen:
            seen.add(candidate)
            found.append(candidate)
            if len(found) >= max_links:
                break
    return found


def _extract_visible_text(html_body):
    parser = _VisibleTextParser()
    parser.feed(html_body)
    return re.sub(r"\s+", " ", html.unescape(parser.text)).strip()


def _normalize_canvas_url(url):
    if not re.match(r"^https?://", (url or ""), flags=re.I):
        return ""
    try:
        parsed = urllib.parse.urlsplit(url)
        path = parsed.path or "/"
        if path != "/":
            path = path.rstrip("/")
        return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, path, "", ""))
    except Exception:
        return (url or "").strip().rstrip("/")


def _evaluate_source_page(url, entry, is_seed, discovered_from=None):
    html_text = _fetch_source_page(url)
    title = _extract_title(html_text)
    visible = _extract_visible_text(html_text)
    row = _score_source_text(
        url,
        title,
        visible,
        entry.get("default_drill"),
        spoken=bool(entry.get("spoken")),
    )
    row["seed_note"] = entry.get("reason")
    row["seed_name"] = entry.get("name", "")
    row["seed_url"] = entry.get("url")
    row["is_seed"] = is_seed
    row["discovered_from"] = discovered_from
    return row, html_text


def _target_is_spoken(target):
    if target.get("spoken"):
        return True
    focus = {str(value).lower() for value in target.get("focus", [])}
    return bool(focus.intersection({"spoken", "speaking", "audio", "dialogue", "dictation", "listen"}))



def cmd_browser(args):
    if not which("node"):
        print(err("node not found — cannot run JS browser controller"))
        sys.exit(2)
    script = os.path.join(ROOT, "scripts", "browser_controller.mjs")
    command = ["node", script]
    if args.url:
        command.append(args.url)
    if args.desktop:
        command.append("--desktop")
    if args.mobile:
        command.append("--mobile")
    if args.both:
        command.append("--both")
    if args.offline:
        command.append("--offline")
    if args.service_workers:
        command.extend(["--service-workers", args.service_workers])
    for click_text in args.click_text or []:
        command += ["--click-text", click_text]
    if args.strict:
        command.append("--strict")
    if args.fail_on_errors:
        command.append("--fail-on-errors")
    if args.out:
        command += ["--out", args.out]
    if args.wait_ms:
        command += ["--wait-ms", str(args.wait_ms)]
    print(head("browser"), flush=True)
    print("  → " + " ".join(command), flush=True)
    r = subprocess.run(command, cwd=ROOT)
    if r.returncode != 0:
        print(err("browser controller failed"))
        sys.exit(r.returncode)


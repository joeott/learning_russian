def write_audio_manifest(ids, voice_id, voice_name):
    os.makedirs(os.path.dirname(AUDIO_MANIFEST_JS), exist_ok=True)
    payload = {"base": "assets/audio/", "voice": voice_name, "voice_id": voice_id, "ids": sorted(ids)}
    with open(AUDIO_MANIFEST_JS, "w", encoding="utf-8") as f:
        f.write("/* AUTO-GENERATED by tools/zastolom audio generate. */\n")
        f.write("window.AUDIO = ")
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write(";\n")

def existing_audio_ids():
    if not os.path.isdir(AUDIO_DIR):
        return set()
    return {fn[:-4] for fn in os.listdir(AUDIO_DIR) if fn.endswith(".mp3")}

def cmd_audio_generate(args):
    data = load_content()
    items = data["items"]
    if args.ids:
        wanted = set(args.ids.split(","))
        items = [i for i in items if i["id"] in wanted]
    if args.limit:
        items = items[: args.limit]
    voice = args.voice or os.environ.get("ZASTOLOM_VOICE") or DEFAULT_VOICE
    voice_name = DEFAULT_VOICE_NAME if voice == DEFAULT_VOICE else voice
    key = resolve_key()
    if not key:
        print(err("ELEVENLABS_API_KEY not found (env or .env). See `zastolom help`."))
        sys.exit(2)
    os.makedirs(AUDIO_DIR, exist_ok=True)
    have = existing_audio_ids()
    todo = [i for i in items if args.force or i["id"] not in have]
    print(head(f"audio: {len(todo)} to synthesize, {len(items) - len(todo)} cached  | voice: {voice_name}"))
    done, failed = 0, 0
    for n, it in enumerate(todo, 1):
        text = strip_stress(it["ru"])  # clean Cyrillic; the multilingual model handles Russian stress
        out = os.path.join(AUDIO_DIR, it["id"] + ".mp3")
        body = json.dumps({
            "text": text, "model_id": EL_MODEL, "output_format": EL_FORMAT,
            "voice_settings": {"stability": 0.45, "similarity_boost": 0.8, "style": 0.0, "use_speaker_boost": True},
        }).encode()
        try:
            r = el_request("POST", f"/text-to-speech/{voice}", key, data=body,
                           headers={"Content-Type": "application/json"})
            audio = r.read()
            with open(out, "wb") as f:
                f.write(audio)
            done += 1
            print(f"  [{n}/{len(todo)}] {ok(it['id'])} {text}  ({len(audio)//1024} KB)")
        except urllib.error.HTTPError as e:
            failed += 1
            print(f"  [{n}/{len(todo)}] {err(it['id'])} HTTP {e.code}: {e.read().decode()[:160]}")
            if e.code in (401, 403):
                print(err("auth/quota problem — stopping.")); break
    # refresh manifest from whatever exists now
    ids = existing_audio_ids() & {i["id"] for i in data["items"]}
    write_audio_manifest(ids, voice, voice_name)
    print(ok(f"synthesized {done}, failed {failed}, total on disk {len(ids)}"))
    print(f"  manifest → web/audio.js  (run `zastolom build anki` to embed [sound:] tags)")

def cmd_audio_voices(args):
    key = resolve_key()
    if not key:
        print(err("ELEVENLABS_API_KEY not found.")); sys.exit(2)
    print(head("Your voice library:"))
    try:
        d = json.load(el_request("GET", "/voices", key))
        for v in d.get("voices", []):
            print(f"  {v['voice_id']}  {v['name']}  ({v.get('category','')})")
    except urllib.error.HTTPError as e:
        print(err(f"voices error {e.code}"))
    print(head("\nShared Russian voices (free-tier, usable directly):"))
    try:
        q = urllib.parse.urlencode({"language": "ru", "page_size": 14})
        d = json.load(el_request("GET", "/shared-voices?" + q, key))
        for v in d.get("voices", []):
            if v.get("free_users_allowed"):
                print(f"  {v.get('voice_id')}  {v.get('name')}  {v.get('gender','')}/{v.get('accent','')}")
    except urllib.error.HTTPError as e:
        print(err(f"shared-voices error {e.code}"))

def cmd_audio_coverage(args):
    data = load_content()
    have = existing_audio_ids()
    miss = [i["id"] for i in data["items"] if i["id"] not in have]
    total = len(data["items"])
    print(head(f"audio coverage: {total - len(miss)}/{total} ({round((total-len(miss))/total*100)}%)"))
    if miss:
        print(warn("missing: " + ", ".join(miss)))
    else:
        print(ok("every phrase has audio"))


            {"url": "https://www.culture.ru", "name": "Culture.ru", "default_drill": ["read", "dictation", "translate"], "reason": "editorial interviews/features", "focus": ["culture", "reading", "interview"], "discover_limit": 4, "discover_paths": ["/ru/news", "/media"]},
            {"url": "https://gramota.ru", "name": "Gramota.ru", "default_drill": ["read", "translate"], "reason": "official language material", "focus": ["reference", "grammar", "reading"], "discover_limit": 4, "discover_paths": ["/spravochnik", "/gramota", "/spravka"]},
            {"url": "https://www.russianpod101.com/welcome", "name": "RussianPod101", "default_drill": ["listen", "dictation", "translate"], "reason": "podcast lessons and transcripts", "spoken": True, "focus": ["spoken", "podcast", "listening", "transcript", "dictation"]},
            {"url": "https://www.youtube.com", "name": "YouTube Russian channels", "default_drill": ["dictation", "shadow", "translate"], "reason": "captioned short-form storytelling channels", "spoken": True, "focus": ["spoken", "audio", "video", "listening", "subtitle"]},
            {"url": "https://www.pushkininstitute.ru/articles", "name": "Pushkin Institute", "default_drill": ["read", "dictation", "translate"], "reason": "authored Russian texts with short practical chunks", "focus": ["reading", "news", "essay"], "discover_limit": 5, "discover_paths": ["/articles/"]},
            {"url": "https://www.ruslang.ru/", "name": "Russian Language Blog", "default_drill": ["read", "translate"], "reason": "easy culture and language prose", "focus": ["reading"]},

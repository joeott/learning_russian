  tools/zastolom preflight http://localhost:8000/web/
  tools/zastolom verify
  tools/zastolom source-loop --run               # discover and score source targets
  tools/zastolom source-loop --spoken --run       # spoken/listening-focused targets only
  tools/zastolom future-loop --run --write-canvas # discover and score linked candidate pages
  tools/zastolom future-loop --spoken --run --write-canvas # build spoken canvas candidates only
  tools/zastolom source-loop               # print the loop prompt only

ELEVENLABS KEY RESOLUTION (first hit wins)
  $ELEVENLABS_API_KEY  →  <repo>/.env  →  ~/Projects/ott_law_redesign/.env  →  ~/Projects/.env

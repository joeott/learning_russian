def _load_canvas_urls(path):
    try:
        with open(path, encoding="utf-8") as f:
            raw = f.read()
    except Exception:
        return set()
    urls = set()
    for match in re.finditer(r"\[[^\]]+\]\(([^)]+)\)", raw):
        url = match.group(1).strip().strip("<>")
        normalized = _normalize_canvas_url(url)
        if not normalized:
            continue
        urls.add(normalized)
    return urls


def _fetch_source_page(url):
    last_err = None
    for user_agent in DEFAULT_SOURCE_USER_AGENTS:
        req = urllib.request.Request(url, headers={"User-Agent": user_agent})
        try:
            with urllib.request.urlopen(req, timeout=18) as r:
                raw = r.read()
            encoding = r.headers.get_content_charset() or "utf-8"
            return raw.decode(encoding, errors="replace")
        except urllib.error.HTTPError as e:
            if e.code in {403, 429, 500, 502, 503, 504}:
                last_err = e
                continue
            raise
        except OSError as e:
            last_err = e
            continue
    raise last_err or RuntimeError(f"unable to fetch {url}")


def _score_source_text(url, title, text, default_drill, spoken=False):
    letters = [ch for ch in text if ch.isalpha()]
    cyrillic = [ch for ch in letters if CYRILLIC_CHAR_RE.match(ch)]
    words = re.findall(r"[А-Яа-яЁёA-Za-z-']+", text)
    word_count = len(words)
    title_clean = re.sub(r"\s+", " ", (title or "").strip())[:120]
    text_snippet = text[:260].replace("\n", " ").strip()
    letter_ratio = len(cyrillic) / max(len(letters), 1)
    length_score = 0
    if 60 <= word_count <= 260:
        length_score = 1.0
    elif 40 <= word_count < 60 or 260 < word_count <= 420:
        length_score = 0.7
    elif 20 <= word_count < 40:
        length_score = 0.5
    elif word_count < 20:
        length_score = 0.0
    else:
        length_score = 0.2
    translation_hint = any(token in text.lower() for token in ("translate", "перевод", "перевести"))
    original_score = 0.9 if translation_hint else 1.0
    trust_score = min(1.0, (0.65 * letter_ratio) + (0.35 * length_score))
    if word_count < 20:
        trust_score *= 0.4
    composite = round(trust_score * original_score, 3)
    status = "rejected"
    if word_count > 420 and composite >= 0.45:
        status = "needs_check"
    elif composite >= 0.68:
        status = "verified"
    elif composite >= 0.45:
        status = "needs_check"
    if spoken:
        lowered = (text + " " + title + " " + url).lower()
        spoken_markers = (
            "аудио",
            "подкаст",
            "подкасты",
            "диалог",
            "разговор",
            "субтитр",
            "смотреть",
            "слушать",
            "транскрипт",
            "listen",
            "podcast",
            "speech",
            "audio",
            "озвучка",
        )
        marker_hits = sum(1 for token in spoken_markers if token in lowered)
        if marker_hits:
            marker_bonus = min(0.10, 0.06 + min(0.08, marker_hits * 0.02))
            composite = min(1.0, round(composite + marker_bonus, 3))
            # Speech-heavy source pages are worth one more check level.
            if status != "verified" and composite >= 0.57:
                status = "needs_check"
    why = []
    if letter_ratio < 0.5:
        why.append("not enough Cyrillic for beginner practice")
    if word_count < 20:
        why.append("too short for meaningful dictation")
    if word_count > 420:
        why.append("too long to fit fast drill pass")
    drill = []
    if status != "rejected":
        drill = default_drill or ["read", "dictation", "translate"]
        if spoken and "dictation" not in drill:
            drill.append("dictation")
        if spoken and "listen" not in drill:
            drill.append("listen")
        if composite > 0.72:
            drill.append("shadow")
    return {
        "url": url,
        "title": title_clean,
        "status": status,
        "scores": {
            "cyrillic_ratio": round(letter_ratio, 3),
            "word_count": word_count,
            "length_score": length_score,
            "composite": composite,
        },
        "notes": why,
        "snippet": text_snippet[:220],
        "suggested_drills": drill,
    }


def _is_easy_candidate(row):
    """Return True for short, beginner-usable candidate material.

    We keep the threshold intentionally narrow for immediate mission use:
    verified quality, not too short/too long, and no explicit length penalty.
    """
    if row.get("status") != "verified":
        return False
    scores = row.get("scores", {})
    word_count = int(scores.get("word_count", 0) or 0)
    if word_count < 40 or word_count > 260:
        return False
    notes = set((row.get("notes") or []))
    for blocked in (
        "too short for meaningful dictation",
        "too long to fit fast drill pass",
    ):
        if blocked in notes:
            return False
    # Keep easy sources stable across spoken/read targets.
    cyrillic_ratio = float(scores.get("cyrillic_ratio", 0.0) or 0.0)
    return cyrillic_ratio >= 0.55


def _source_loop_candidates(rows, easy=False):
    candidates = [r for r in rows if r.get("status") in {"verified", "needs_check"}]
    if not easy:
        return candidates
    easy_rows = [r for r in candidates if _is_easy_candidate(r)]
    return easy_rows if easy_rows else candidates


def _extract_title(html_text):
    match = re.search(r"<title[^>]*>(.*?)</title>", html_text, flags=re.I | re.S)
    if not match:
        return ""
    raw = html.unescape(match.group(1))
    return re.sub(r"\s+", " ", raw).strip()


def cmd_source_loop(args):
    if not args.run:
        path = os.path.join(ROOT, "prompts", "source-material-loop.md")
        with open(path, encoding="utf-8") as f:
            print(f.read())
        return
    targets = _read_source_targets(args.targets, spoken=args.spoken)
    if args.limit:
        targets = targets[: args.limit]
    rows = []
    seen = set()
    for idx, entry in enumerate(targets, 1):
        url = entry.get("url")
        if not url:
            continue
        normalized = _normalize_canvas_url(url)
        if not normalized:
            continue
        try:
            row, html_text = _evaluate_source_page(normalized, entry, is_seed=True)
            rows.append(row)
            seen.add(normalized)
            status = row["status"]
            print(head(f"[{idx}/{len(targets)}] {row['seed_name']}"))
            print(f"  -> status: {status} | composite: {row['scores']['composite']} | words: {row['scores']['word_count']}")

            if args.future:
                discovered = _discover_source_links(normalized, html_text, entry)
                if discovered:
                    print(f"  -> discovered: {len(discovered)} candidate link(s)")
                for discovered_url in discovered:
                    if discovered_url in seen:
                        continue
                    try:
                        child_row, _ = _evaluate_source_page(
                            discovered_url, entry, is_seed=False, discovered_from=row["url"]
                        )
                        child_row["seed_name"] = row["seed_name"]
                        child_row["seed_url"] = row["url"]
                        rows.append(child_row)
                        seen.add(discovered_url)
                    except Exception:
                        continue
        except Exception as e:
            msg = f"{type(e).__name__}: {e}"
            rows.append({
                "url": normalized,
                "title": entry.get("name", ""),
                "status": "rejected",
                "scores": {
                    "cyrillic_ratio": 0.0,
                    "word_count": 0,
                    "length_score": 0.0,
                    "composite": 0.0,
                },
                "notes": [f"fetch_error: {msg}"],
                "snippet": "",
                "suggested_drills": [],
                "seed_note": entry.get("reason"),
                "seed_name": entry.get("name", ""),
                "seed_url": normalized,
                "is_seed": True,
                "discovered_from": None,
            })
            print(warn(f"[{idx}/{len(targets)}] {url} → {msg}"))

    os.makedirs(os.path.dirname(SOURCE_LOOP_LOG), exist_ok=True)
    payload = {
        "generated_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "candidates": rows,
        "summary": {
            "targets": len(rows),
            "discovered": sum(1 for r in rows if not r.get("is_seed")),
            "verified": sum(1 for r in rows if r["status"] == "verified"),
            "needs_check": sum(1 for r in rows if r["status"] == "needs_check"),
            "rejected": sum(1 for r in rows if r["status"] == "rejected"),
        },
    }
    with open(SOURCE_LOOP_LOG, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2, sort_keys=True)
    print(ok(f"source loop logged → {SOURCE_LOOP_LOG}"))

    if args.write_canvas:
        accepted = _source_loop_candidates(
            rows, easy=bool(getattr(args, "easy", False))
        )
        if args.future:
            accepted = [r for r in accepted if not r.get("is_seed")]
        existing = _load_canvas_urls(SOURCE_CANDIDATE_FILE)
        new_candidates = [
            r for r in accepted if (r["url"] or "").strip() and _normalize_canvas_url(r["url"]) not in existing
        ]
        if not accepted:
            print(warn("no sources passed the threshold for canvas write"))
            return
        if not new_candidates:
            print(warn("no new candidate URLs after dedupe"))
            return
        with open(SOURCE_CANDIDATE_FILE, "a", encoding="utf-8") as f:
            f.write(f"\n## Week {datetime.now(timezone.utc).date().isoformat()}\n")
            f.write("- Generated by: `")
            if args.future:
                f.write("tools/zastolom future-loop --run --write-canvas")
            else:
                f.write("tools/zastolom source-loop --run --write-canvas")
            if getattr(args, "easy", False):
                f.write(" --easy")
            if args.spoken:
                f.write(" --spoken")
            f.write("`\n")
            for row in new_candidates:
                status = row["status"]
                drill = ", ".join(row["suggested_drills"]) if row["suggested_drills"] else "to review"
                f.write(f"- Source: [{row['title'] or row['url']}]({row['url']})\n")
                if row.get("discovered_from"):
                    f.write(f"- From: {row.get('seed_name') or row.get('seed_url')} -> {row['discovered_from']}\n")
                f.write(f"- Notes: {', '.join(row['notes']) or 'quick check recommended'}\n")
                f.write(f"- Level: {'L1-L2' if status == 'verified' else 'L1-L3'}\n")
                f.write(f"- Use: {drill}\n")
                f.write(f"- Status: {status}\n")
                f.write("- Suggested drill fragment:\n")
                f.write(f"  - {row['suggested_drills'][0] if row['suggested_drills'] else 'read'}\n")
                f.write(f"  - {row['suggested_drills'][1] if len(row['suggested_drills']) > 1 else 'dictation'}\n")
                f.write(f"  - {row['suggested_drills'][2] if len(row['suggested_drills']) > 2 else 'translate'}\n")
            f.write("\n")
        print(ok(f"candidate canvas updated → {SOURCE_CANDIDATE_FILE}"))


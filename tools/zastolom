#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
zastolom — the agentic CLI for the «За столо́м» Russian study system.

One entry point for every aspect of this repo: regenerate content, synthesize
high-quality ElevenLabs audio, serve the app, validate everything, print stats.
Stdlib-only (urllib) — no pip install required.

USAGE
  tools/zastolom <command> [options]

COMMANDS
  build [target]        Regenerate artifacts. target = content|anki|cheatsheet|all (default: all)
  audio generate        Synthesize MP3s for phrases via ElevenLabs (idempotent)
  audio voices          List Russian voices (your library + shared library)
  audio coverage        Report which phrases have audio
  serve                 Serve the repo over HTTP and print the app URL
  browser               Inspect the local web app with the JS browser controller
  verify                Run all health checks (JSON, JS syntax, audio coverage)
  test                  Run stdlib validation/unit tests
  loop-prompt           Print the local iterative improvement-loop prompt
  stats                 Print content statistics
  help                  Show this help

EXAMPLES
  tools/zastolom build
  tools/zastolom audio generate            # fill in any missing audio
  tools/zastolom audio generate --force    # re-synthesize everything
  tools/zastolom audio generate --ids firs001,toas001 --voice ScaQ3utur72x93jqMMeU
  tools/zastolom serve --port 8000
  tools/zastolom browser http://localhost:8000/web/#/quiz --mobile
  tools/zastolom browser http://localhost:8000/web/#/quiz/roleplay --mobile --click-text "Reveal model answer" --click-text "Close with model"
  tools/zastolom verify

ELEVENLABS KEY RESOLUTION (first hit wins)
  $ELEVENLABS_API_KEY  →  <repo>/.env  →  ~/Projects/ott_law_redesign/.env  →  ~/Projects/.env
VOICE: $ZASTOLOM_VOICE or --voice (default: Elena «Warm, Calm & Clear» ScaQ3utur72x93jqMMeU)
"""
import argparse
import json
import os
import re
import subprocess
import sys
import unicodedata
import urllib.request
import urllib.parse
import urllib.error

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTENT = os.path.join(ROOT, "content", "content.json")
AUDIO_DIR = os.path.join(ROOT, "web", "assets", "audio")
AUDIO_MANIFEST_JS = os.path.join(ROOT, "web", "audio.js")
ANKI_MEDIA = os.path.join(ROOT, "anki", "media")
ACUTE = "́"

EL_API = "https://api.elevenlabs.io/v1"
EL_MODEL = "eleven_multilingual_v2"
EL_FORMAT = "mp3_44100_128"
DEFAULT_VOICE = "ScaQ3utur72x93jqMMeU"      # Elena — Warm, Calm & Clear (ru, standard)
DEFAULT_VOICE_NAME = "Elena (Warm, Calm & Clear)"

# ---- pretty ----
def c(s, code):  # color if tty
    return f"\033[{code}m{s}\033[0m" if sys.stdout.isatty() else s
def ok(s): return c("✓ " + s, "32")
def warn(s): return c("! " + s, "33")
def err(s): return c("✗ " + s, "31")
def head(s): return c(s, "1;35")

def load_content():
    with open(CONTENT, encoding="utf-8") as f:
        return json.load(f)

def strip_stress(s):
    return unicodedata.normalize("NFC", s).replace(ACUTE, "")

# ---- key + voice resolution ----
def _read_env_file(path, var):
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith(var + "="):
                    return line.split("=", 1)[1].strip().strip('"').strip("'")
    except OSError:
        return None
    return None

def resolve_key():
    if os.environ.get("ELEVENLABS_API_KEY"):
        return os.environ["ELEVENLABS_API_KEY"]
    home = os.path.expanduser("~")
    for p in (os.path.join(ROOT, ".env"),
              os.path.join(home, "Projects", "ott_law_redesign", ".env"),
              os.path.join(home, "Projects", ".env")):
        v = _read_env_file(p, "ELEVENLABS_API_KEY")
        if v:
            return v
    return None

def el_request(method, path, key, data=None, headers=None, timeout=90):
    h = {"xi-api-key": key}
    if headers:
        h.update(headers)
    req = urllib.request.Request(EL_API + path, data=data, headers=h, method=method)
    return urllib.request.urlopen(req, timeout=timeout)

# ============================================================ BUILD
def run_script(name, env=None):
    p = os.path.join(ROOT, "scripts", name)
    print(f"  → python3 scripts/{name}")
    r = subprocess.run([sys.executable, p], cwd=ROOT, env=env)
    if r.returncode != 0:
        sys.exit(r.returncode)

def cmd_build(args):
    target = args.target or "all"
    print(head(f"build: {target}"))
    env = os.environ.copy()
    if getattr(args, "course", None):
        env["ZASTOLOM_COURSE"] = args.course
    if target in ("content", "all"):
        run_script("build_content.py", env=env)
    if target in ("anki", "all"):
        run_script("build_anki.py", env=env)
    if target in ("cheatsheet", "all"):
        run_script("build_cheatsheet.py", env=env)
    print(ok("build complete"))

# ============================================================ AUDIO
def write_audio_manifest(ids, voice_id, voice_name):
    os.makedirs(os.path.dirname(AUDIO_MANIFEST_JS), exist_ok=True)
    payload = {"base": "assets/audio/", "voice": voice_name, "voice_id": voice_id, "ids": sorted(ids)}
    with open(AUDIO_MANIFEST_JS, "w", encoding="utf-8") as f:
        f.write("/* AUTO-GENERATED by tools/zastolom audio generate. */\n")
        f.write("window.AUDIO = ")
        json.dump(payload, f, ensure_ascii=False, indent=2)
        f.write(";\n")

def existing_audio_ids():
    if not os.path.isdir(AUDIO_DIR):
        return set()
    return {fn[:-4] for fn in os.listdir(AUDIO_DIR) if fn.endswith(".mp3")}

def cmd_audio_generate(args):
    data = load_content()
    items = data["items"]
    if args.ids:
        wanted = set(args.ids.split(","))
        items = [i for i in items if i["id"] in wanted]
    if args.limit:
        items = items[: args.limit]
    voice = args.voice or os.environ.get("ZASTOLOM_VOICE") or DEFAULT_VOICE
    voice_name = DEFAULT_VOICE_NAME if voice == DEFAULT_VOICE else voice
    key = resolve_key()
    if not key:
        print(err("ELEVENLABS_API_KEY not found (env or .env). See `zastolom help`."))
        sys.exit(2)
    os.makedirs(AUDIO_DIR, exist_ok=True)
    have = existing_audio_ids()
    todo = [i for i in items if args.force or i["id"] not in have]
    print(head(f"audio: {len(todo)} to synthesize, {len(items) - len(todo)} cached  | voice: {voice_name}"))
    done, failed = 0, 0
    for n, it in enumerate(todo, 1):
        text = strip_stress(it["ru"])  # clean Cyrillic; the multilingual model handles Russian stress
        out = os.path.join(AUDIO_DIR, it["id"] + ".mp3")
        body = json.dumps({
            "text": text, "model_id": EL_MODEL, "output_format": EL_FORMAT,
            "voice_settings": {"stability": 0.45, "similarity_boost": 0.8, "style": 0.0, "use_speaker_boost": True},
        }).encode()
        try:
            r = el_request("POST", f"/text-to-speech/{voice}", key, data=body,
                           headers={"Content-Type": "application/json"})
            audio = r.read()
            with open(out, "wb") as f:
                f.write(audio)
            done += 1
            print(f"  [{n}/{len(todo)}] {ok(it['id'])} {text}  ({len(audio)//1024} KB)")
        except urllib.error.HTTPError as e:
            failed += 1
            print(f"  [{n}/{len(todo)}] {err(it['id'])} HTTP {e.code}: {e.read().decode()[:160]}")
            if e.code in (401, 403):
                print(err("auth/quota problem — stopping.")); break
    # refresh manifest from whatever exists now
    ids = existing_audio_ids() & {i["id"] for i in data["items"]}
    write_audio_manifest(ids, voice, voice_name)
    print(ok(f"synthesized {done}, failed {failed}, total on disk {len(ids)}"))
    print(f"  manifest → web/audio.js  (run `zastolom build anki` to embed [sound:] tags)")

def cmd_audio_voices(args):
    key = resolve_key()
    if not key:
        print(err("ELEVENLABS_API_KEY not found.")); sys.exit(2)
    print(head("Your voice library:"))
    try:
        d = json.load(el_request("GET", "/voices", key))
        for v in d.get("voices", []):
            print(f"  {v['voice_id']}  {v['name']}  ({v.get('category','')})")
    except urllib.error.HTTPError as e:
        print(err(f"voices error {e.code}"))
    print(head("\nShared Russian voices (free-tier, usable directly):"))
    try:
        q = urllib.parse.urlencode({"language": "ru", "page_size": 14})
        d = json.load(el_request("GET", "/shared-voices?" + q, key))
        for v in d.get("voices", []):
            if v.get("free_users_allowed"):
                print(f"  {v.get('voice_id')}  {v.get('name')}  {v.get('gender','')}/{v.get('accent','')}")
    except urllib.error.HTTPError as e:
        print(err(f"shared-voices error {e.code}"))

def cmd_audio_coverage(args):
    data = load_content()
    have = existing_audio_ids()
    miss = [i["id"] for i in data["items"] if i["id"] not in have]
    total = len(data["items"])
    print(head(f"audio coverage: {total - len(miss)}/{total} ({round((total-len(miss))/total*100)}%)"))
    if miss:
        print(warn("missing: " + ", ".join(miss)))
    else:
        print(ok("every phrase has audio"))

# ============================================================ SERVE / VERIFY / STATS
def cmd_serve(args):
    port = args.port
    url = f"http://localhost:{port}/web/"
    print(head(f"serving {ROOT}"))
    print(ok(f"app:        {url}"))
    print(ok(f"cheatsheet: http://localhost:{port}/printable/cheatsheet.html"))
    print("  Ctrl-C to stop.\n")
    try:
        subprocess.run([sys.executable, "-m", "http.server", str(port)], cwd=ROOT)
    except KeyboardInterrupt:
        pass

def cmd_browser(args):
    if not which("node"):
        print(err("node not found — cannot run JS browser controller"))
        sys.exit(2)
    script = os.path.join(ROOT, "scripts", "browser_controller.mjs")
    command = ["node", script]
    if args.url:
        command.append(args.url)
    if args.desktop:
        command.append("--desktop")
    if args.mobile:
        command.append("--mobile")
    if args.both:
        command.append("--both")
    for click_text in args.click_text or []:
        command += ["--click-text", click_text]
    if args.out:
        command += ["--out", args.out]
    if args.wait_ms:
        command += ["--wait-ms", str(args.wait_ms)]
    print(head("browser"), flush=True)
    print("  → " + " ".join(command), flush=True)
    r = subprocess.run(command, cwd=ROOT)
    if r.returncode != 0:
        print(err("browser controller failed"))
        sys.exit(r.returncode)

def cmd_verify(args):
    fails = 0
    print(head("verify"))
    # 1 content json
    try:
        d = load_content()
        n = d["meta"]["total_items"]
        assert n == len(d["items"])
        print(ok(f"content.json valid — {n} items"))
    except Exception as e:
        fails += 1; print(err(f"content.json: {e}"))
    # 2 web/content.js mirrors json
    try:
        js = open(os.path.join(ROOT, "web", "content.js"), encoding="utf-8").read()
        print(ok("web/content.js present") if "CONTENT_DATA" in js else err("web/content.js malformed"))
    except OSError:
        fails += 1; print(err("web/content.js missing — run `zastolom build content`"))
    # 3 JS syntax (node if available)
    if which("node"):
        for f in ("web/app.js", "web/service-worker.js"):
            r = subprocess.run(["node", "--check", os.path.join(ROOT, f)], capture_output=True)
            if r.returncode == 0:
                print(ok(f"{f} syntax OK"))
            else:
                fails += 1; print(err(f"{f}: {r.stderr.decode()[:160]}"))
    else:
        print(warn("node not found — skipped JS syntax check"))
    # 4 audio coverage (informational)
    try:
        d = load_content(); have = existing_audio_ids()
        miss = [i["id"] for i in d["items"] if i["id"] not in have]
        (print(ok("audio: full coverage")) if not miss
         else print(warn(f"audio: {len(miss)} missing (run `zastolom audio generate`)")))
    except Exception:
        pass
    # 5 anki rows
    try:
        rows = sum(1 for _ in open(os.path.join(ROOT, "anki", "russian_family_visit.txt"), encoding="utf-8")) - 3
        print(ok(f"anki deck: {rows} rows"))
    except OSError:
        print(warn("anki deck not built"))
    print(ok("verify passed") if not fails else err(f"verify FAILED ({fails})"))
    sys.exit(1 if fails else 0)

def cmd_test(args):
    print(head("test"))
    commands = [
        [sys.executable, "scripts/validate_content.py"],
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
    ]
    for command in commands:
        print("  → " + " ".join(command))
        r = subprocess.run(command, cwd=ROOT)
        if r.returncode != 0:
            print(err("test failed"))
            sys.exit(r.returncode)
    print(ok("test passed"))

def cmd_loop_prompt(args):
    path = os.path.join(ROOT, "prompts", "improve-loop.md")
    with open(path, encoding="utf-8") as f:
        print(f.read())

def cmd_stats(args):
    d = load_content()
    print(head(d["meta"]["title"]))
    print(f"  goal: {d['meta']['goal']}")
    print(f"  total phrases: {d['meta']['total_items']}")
    by_pri = {}
    for i in d["items"]:
        by_pri[i["priority"]] = by_pri.get(i["priority"], 0) + 1
    print("  by module:")
    for m in d["modules"]:
        n = d["meta"]["counts"].get(m["id"], 0)
        print(f"    {m['icon']} {m['title']:<34} {n:>3}  (P{m['priority']})")
    print(f"  by priority: " + "  ".join(f"P{k}={v}" for k, v in sorted(by_pri.items())))
    reh = [i["ru"] for i in d["items"] if i["rehearse"]]
    print(f"  ★ rehearse with Kadriya: {len(reh)}")
    have = existing_audio_ids()
    print(f"  audio on disk: {len(have & {i['id'] for i in d['items']})}/{d['meta']['total_items']}")

def which(prog):
    from shutil import which as w
    return w(prog)

# ============================================================ main
def main():
    p = argparse.ArgumentParser(prog="zastolom", add_help=False,
                                description="Agentic CLI for the За столо́м Russian study system.")
    sub = p.add_subparsers(dest="cmd")

    b = sub.add_parser("build"); b.add_argument("target", nargs="?", choices=["content", "anki", "cheatsheet", "all"]); b.add_argument("--course")
    a = sub.add_parser("audio"); asub = a.add_subparsers(dest="acmd")
    g = asub.add_parser("generate")
    g.add_argument("--force", action="store_true"); g.add_argument("--ids"); g.add_argument("--voice"); g.add_argument("--limit", type=int)
    asub.add_parser("voices"); asub.add_parser("coverage")
    s = sub.add_parser("serve"); s.add_argument("--port", type=int, default=8000)
    br = sub.add_parser("browser")
    br.add_argument("url", nargs="?", default="http://localhost:8000/web/")
    group = br.add_mutually_exclusive_group()
    group.add_argument("--desktop", action="store_true")
    group.add_argument("--mobile", action="store_true")
    group.add_argument("--both", action="store_true")
    br.add_argument("--click-text", action="append")
    br.add_argument("--out")
    br.add_argument("--wait-ms", type=int)
    sub.add_parser("verify"); sub.add_parser("test"); sub.add_parser("loop-prompt"); sub.add_parser("stats")
    sub.add_parser("help")

    args = p.parse_args()
    if not args.cmd or args.cmd == "help":
        print(__doc__); return
    if args.cmd == "build": cmd_build(args)
    elif args.cmd == "audio":
        {"generate": cmd_audio_generate, "voices": cmd_audio_voices,
         "coverage": cmd_audio_coverage}.get(args.acmd, lambda a: print(__doc__))(args)
    elif args.cmd == "serve": cmd_serve(args)
    elif args.cmd == "browser": cmd_browser(args)
    elif args.cmd == "verify": cmd_verify(args)
    elif args.cmd == "test": cmd_test(args)
    elif args.cmd == "loop-prompt": cmd_loop_prompt(args)
    elif args.cmd == "stats": cmd_stats(args)

if __name__ == "__main__":
    main()
